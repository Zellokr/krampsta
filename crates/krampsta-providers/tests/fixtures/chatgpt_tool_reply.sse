 its timeout, with everything it started, so never start servers or watchers that don't exit. Prefer read_file, list_files and search for looking at files.","parameters":{"properties":{"command":{"description":"The PowerShell command line.","type":"string"},"timeout_ms":{"description":"Default: 120000 (2 minutes).","maximum":600000,"minimum":1000,"type":"integer"}},"required":["command"],"type":"object"},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"00000000-0000-0000-0000-000000000000","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"medium"},"top_p":1.0,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"low","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":1170,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"cache_write_tokens_details":{"ttl_30m_tokens":0,"ttl_12h_tokens":0}},"output_tokens":32,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":1202,"attribution":{"items":{"fc_07dc59c03542caf1016aff658ecc2087d28466d9014322d5ce":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dc59c03542caf1016aff658ecc2087d2a115ef1ae226c629":{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_07dc59c03542caf1016aff658ecc1c87d290686da378e1149f":{"input_tokens":138,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":138,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_07dc59c03542caf1016aff658ecc1c87d2949baeec6aea218f":{"input_tokens":16,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":16,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_07dc59c03542caf1016aff658ecc1c87d296574651d3a83ff8":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"out